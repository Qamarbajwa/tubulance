-    kx, ky, kz = wavenumbers(cfg.grid_n, cfg.domain_length)
-    kmag = np.sqrt(kx * kx + ky * ky + kz * kz)
-    nyquist = float(np.max(np.abs(kx[:, 0, 0])))
-    delta_k = 2.0 * np.pi / cfg.domain_length

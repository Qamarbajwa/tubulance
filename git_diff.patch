-def shell_spectrum(uh: np.ndarray, kmag: np.ndarray):
-    n3 = np.prod(uh.shape[1:])
-    modal = 0.5 * np.sum(np.abs(uh) ** 2, axis=0) / (n3 * n3)
-    return bin_shells(modal, kmag)

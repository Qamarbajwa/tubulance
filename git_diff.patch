-        shape = kmag.shape
-        fresh = rng.normal(size=(3,) + shape) + 1j * rng.normal(size=(3,) + shape)
-        if direction is not None:
-            directed = (rng.normal(size=shape) + 1j * rng.normal(size=shape))
-            directed_vec = direction[:, None, None, None] * directed[None, ...]

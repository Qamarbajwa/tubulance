-
-    @staticmethod
-    def from_json(text: str) -> "RunIdentity":
-        return RunIdentity(**json.loads(text))
-
-
-def new_run_identity(manifest_path: str, run_id: str, manifest_hash_value: str, seed: int | None) -> RunIdentity:

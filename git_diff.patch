-def spectral_relative_l2(reference: np.ndarray, model: np.ndarray, mask: np.ndarray) -> float:
-    denominator = np.sum(reference[mask] ** 2)
-    if denominator <= 0:
-        return float("nan")
-    return float(np.sqrt(np.sum((model[mask] - reference[mask]) ** 2) / denominator))

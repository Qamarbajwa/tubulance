-def project_divergence_free(uh: np.ndarray, kx, ky, kz) -> np.ndarray:
-    k2 = kx * kx + ky * ky + kz * kz
-    safe = np.where(k2 == 0.0, 1.0, k2)
-    dot = kx * uh[0] + ky * uh[1] + kz * uh[2]
-    out = uh.copy()
-    out[0] -= kx * dot / safe
-    out[1] -= ky * dot / safe
-    out[2] -= kz * dot / safe
-    out[:, k2 == 0.0] = 0.0
-    return out

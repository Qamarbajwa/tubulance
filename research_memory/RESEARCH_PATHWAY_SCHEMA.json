{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchPathwaySchema",
  "description": "Schema for NS-RPM-1 Research Pathway Memory entries",
  "type": "object",
  "required": [
    "pathway_id",
    "title",
    "parent_pathways",
    "descendant_pathways",
    "starting_thesis",
    "scientific_question",
    "intended_bridge",
    "core_objects",
    "mathematical_form",
    "scaling",
    "geometry",
    "trajectory_dependence",
    "stochastic_component",
    "assumptions",
    "domain",
    "regularity_class",
    "expected_outcome",
    "actual_outcome",
    "tests_attempted",
    "evidence_refs",
    "status",
    "termination_reason",
    "failure_mechanism",
    "what_was_falsified",
    "what_was_not_falsified",
    "surviving_results",
    "negative_results",
    "open_questions",
    "obstruction_ids",
    "reopen_conditions",
    "similarity_tags",
    "last_re_evaluated"
  ],
  "properties": {
    "pathway_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "title": { "type": "string" },
    "parent_pathways": { "type": "array", "items": { "type": "string" } },
    "descendant_pathways": { "type": "array", "items": { "type": "string" } },
    "starting_thesis": { "type": "string" },
    "scientific_question": { "type": "string" },
    "intended_bridge": { "type": "string" },
    "core_objects": { "type": "array", "items": { "type": "string" } },
    "mathematical_form": { "type": "string" },
    "scaling": { "type": "string" },
    "geometry": { "type": "string" },
    "trajectory_dependence": { "type": "string", "enum": ["EULERIAN", "LAGRANGIAN_DETERMINISTIC", "LAGRANGIAN_STOCHASTIC", "HYBRID"] },
    "stochastic_component": { "type": "boolean" },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "domain": { "type": "string" },
    "regularity_class": { "type": "string" },
    "expected_outcome": { "type": "string" },
    "actual_outcome": { "type": "string" },
    "tests_attempted": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "COMPLETED_CANONICAL",
        "COMPLETED_CANONICAL_WITH_LIMITATIONS",
        "FALSIFIED",
        "TERMINATED_BY_OBSTRUCTION",
        "SUPERSEDED_AS_PRIMARY_OBJECT",
        "REFORMULATED",
        "DORMANT",
        "RESURRECTION_CANDIDATE"
      ]
    },
    "termination_reason": { "type": "string" },
    "failure_mechanism": { "type": "string" },
    "what_was_falsified": { "type": "array", "items": { "type": "string" } },
    "what_was_not_falsified": { "type": "array", "items": { "type": "string" } },
    "surviving_results": { "type": "array", "items": { "type": "string" } },
    "negative_results": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "obstruction_ids": { "type": "array", "items": { "type": "string" } },
    "reopen_conditions": { "type": "array", "items": { "type": "string" } },
    "similarity_tags": { "type": "array", "items": { "type": "string" } },
    "last_re_evaluated": { "type": "string" }
  },
  "additionalProperties": false
}
